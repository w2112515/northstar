# Copy to .env and fill in. NEVER commit .env.
ALPACA_API_KEY=your_alpaca_paper_key      # starts with PK (paper only!)
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_PAPER=true
ACCOUNT_ROLE=dev                          # dev | competition
GOOGLE_API_KEY=                           # aistudio.google.com, needed for AI nodes
GEMINI_FLASH_MODEL=gemini-2.5-flash       # triage/explainer model
GEMINI_PRO_MODEL=gemini-2.5-pro           # evolution proposer model
JOURNAL_STORE=local                       # local | firestore
LOOP_MINUTES=15                           # autopilot tick interval

