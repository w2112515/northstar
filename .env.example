# Copy to .env and fill in. NEVER commit .env.
ALPACA_API_KEY=your_alpaca_paper_key      # starts with PK (paper only!) - default pair
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_API_KEY_COMPETITION=               # optional second account: role-suffixed pair
ALPACA_SECRET_KEY_COMPETITION=            # wins over the default when ACCOUNT_ROLE matches
ALPACA_PAPER=true
ACCOUNT_ROLE=dev                          # dev(=Google demo) | competition(=Alpaca P&L)
                                          # switch accounts by changing THIS line only;
                                          # journal/state live in data/<role>/ per account
GOOGLE_API_KEY=                           # aistudio.google.com, needed for AI nodes
# Models default in code: gemini-3.7-flash primary, gemini-3.5-flash fallback.
# Uncomment only to override (note: 3.1-pro-preview has ZERO free-tier quota):
# GEMINI_FLASH_MODEL=gemini-3.7-flash
# GEMINI_PRO_MODEL=gemini-3.7-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
JOURNAL_STORE=local                       # local | firestore
LOOP_MINUTES=15                           # autopilot tick interval

# --- research-flywheel kill switches (all loops run by default; set =1 to
#     disable one honestly - the journal records the degradation) -------------
# NORTHSTAR_SCOUT_DISABLED=1              # market-wide screener radar
# NORTHSTAR_OPTIONS_SCAN_DISABLED=1       # CSP premium-yield options watch
# NORTHSTAR_FACTORS_DISABLED=1            # nightly known-factor rank-IC screen
# NORTHSTAR_SHIPYARD_DISABLED=1           # structural evolution (strategy DSL)
# NORTHSTAR_MINING_DISABLED=1             # factor-expression mining lite
# NORTHSTAR_COMPASS_DISABLED=1            # market regime compass
# NORTHSTAR_COMPASS_LLM_DISABLED=1        # compass hypothesis narration only
# NORTHSTAR_ADVISOR_DISABLED=1            # helm advisor (HITL sleeve tilts)
# NORTHSTAR_CAPTAIN_LLM_DISABLED=1        # captain's log narration (template stays)
# NORTHSTAR_ADMIN_TOKEN=                  # set on public deploys: mutating API
#                                         # calls then require this token (the web
#                                         # proxy injects it server-side). deploy.ps1
#                                         # generates one if unset. Local dev: leave off.

